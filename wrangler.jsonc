{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leadfinder",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Created manually by the user: `wrangler d1 create leadfinder-db`, then
  // paste the returned database_id here. See MILESTONES.md Milestone 7.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leadfinder-db",
      "database_id": "REPLACE_WITH_REAL_D1_DATABASE_ID",
      "migrations_dir": "drizzle"
    }
  ]
}
