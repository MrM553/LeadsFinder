{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name Cloudflare's Git-integration build actually
  // deployed as ("leadsfinder", from the repo name) — it does NOT read this
  // field to name the Worker when deploying via the dashboard's "Import a
  // repository" flow, which caused secrets set against "leadfinder" (this
  // field's old value) to attach to the wrong, unused Worker. Keep these in
  // sync, or CLI commands (secrets, migrations) will silently target the
  // wrong Worker again.
  "name": "leadsfinder",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-06-01",
  // nodejs_compat_populate_process_env: without it, process.env.AUTH_SECRET
  // etc. (set via `wrangler secret put`) would be undefined at runtime —
  // env.ts reads them as plain process.env, confirmed required via live docs.
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leadfinder-db",
      "database_id": "fd192e09-e51f-40f0-8ebc-d94fa18ca94f",
      "migrations_dir": "drizzle"
    }
  ]
}
