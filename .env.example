# Local SQLite database file path (relative to project root)
DATABASE_URL=data/leadfinder.db

# Dashboard auth (Milestone 5)
# AUTH_SECRET: any long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
AUTH_SECRET=
DASHBOARD_USERNAME=
# Generate with: npm run auth:hash-password -- "your-password"
DASHBOARD_PASSWORD_HASH=
